

-- =====================================================================
-- DATABASE quan_an_db: BẢN HOÀN CHỈNH (đã gộp v7 -> v16)
-- Chạy 1 lần trên DB trống. Không có phần update/vá.
-- =====================================================================

CREATE DATABASE IF NOT EXISTS quan_an_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE quan_an_db;

-- 1. USERS
CREATE TABLE users (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  full_name VARCHAR(120) NOT NULL,
  email VARCHAR(255) NOT NULL UNIQUE,
  phone VARCHAR(30) NULL,
  password_hash VARCHAR(255) NULL,
  role ENUM('customer','phuc_vu','thu_ngan','kitchen','manager') NOT NULL DEFAULT 'customer',
  avatar_url VARCHAR(500) NULL,
  is_active BOOLEAN NOT NULL DEFAULT TRUE,
  google_id VARCHAR(255) NULL UNIQUE,
  is_verified BOOLEAN NOT NULL DEFAULT FALSE,
  verification_token VARCHAR(64) NULL,
  verification_token_expires DATETIME NULL,
  reset_token CHAR(64) NULL,
  reset_token_expires DATETIME NULL,
  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- 2. SETTINGS
CREATE TABLE settings (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  setting_key VARCHAR(100) NOT NULL UNIQUE,
  setting_value VARCHAR(255) NOT NULL,
  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- 3. INGREDIENTS
CREATE TABLE ingredients (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(120) NOT NULL UNIQUE,
  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- 4. DISH_CATEGORIES
CREATE TABLE dish_categories (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(100) NOT NULL UNIQUE,
  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- 5. DISHES
CREATE TABLE dishes (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(180) NOT NULL,
  description TEXT NULL,
  price DECIMAL(12,2) NOT NULL,
  category VARCHAR(100) NULL,
  category_id INT UNSIGNED NULL,
  image_url VARCHAR(500) NULL,
  is_available BOOLEAN NOT NULL DEFAULT TRUE,
  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  INDEX idx_dishes_category_id (category_id),
  CONSTRAINT fk_dishes_category FOREIGN KEY (category_id) REFERENCES dish_categories(id) ON DELETE RESTRICT
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- 6. DISH_IMAGES
CREATE TABLE dish_images (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  dish_id INT UNSIGNED NOT NULL,
  image_url VARCHAR(500) NOT NULL,
  sort_order SMALLINT UNSIGNED NOT NULL DEFAULT 0,
  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  UNIQUE KEY uq_dish_images_dish_url (dish_id, image_url),
  INDEX idx_dish_images_dish_sort (dish_id, sort_order),
  FOREIGN KEY (dish_id) REFERENCES dishes(id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- 7. DISH_INGREDIENTS
CREATE TABLE dish_ingredients (
  dish_id INT UNSIGNED NOT NULL,
  ingredient_id INT UNSIGNED NOT NULL,
  quantity_g DECIMAL(10,2) NULL,
  PRIMARY KEY (dish_id, ingredient_id),
  INDEX idx_dish_ingredients_ingredient (ingredient_id),
  FOREIGN KEY (dish_id) REFERENCES dishes(id) ON DELETE CASCADE,
  FOREIGN KEY (ingredient_id) REFERENCES ingredients(id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- 8. USER_EXCLUDED_INGREDIENTS
CREATE TABLE user_excluded_ingredients (
  user_id INT UNSIGNED NOT NULL,
  ingredient_id INT UNSIGNED NOT NULL,
  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (user_id, ingredient_id),
  FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
  FOREIGN KEY (ingredient_id) REFERENCES ingredients(id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- 9. RESTAURANT_TABLES (FK current_reservation_id thêm sau khi có reservations)
CREATE TABLE restaurant_tables (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  table_number VARCHAR(10) NOT NULL UNIQUE,
  capacity INT NOT NULL,
  status ENUM('trong','giu_tam','da_dat','co_khach') NOT NULL DEFAULT 'trong',
  locked_by INT UNSIGNED NULL,
  locked_until DATETIME NULL,
  current_reservation_id INT UNSIGNED NULL,
  INDEX idx_tables_status (status),
  FOREIGN KEY (locked_by) REFERENCES users(id) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- 10. RESERVATIONS
CREATE TABLE reservations (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  user_id INT UNSIGNED NOT NULL,
  party_size INT NOT NULL,
  reservation_date DATE NOT NULL,
  reservation_time TIME NOT NULL,
  phone VARCHAR(15) NULL,
  status ENUM('giu_tam','da_dat','hoan_thanh','da_huy','qua_han') NOT NULL DEFAULT 'giu_tam',
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  cancelled_at DATETIME NULL,
  cancelled_by ENUM('customer','staff') NULL,
  INDEX idx_reservations_date (reservation_date),
  INDEX idx_reservations_status (status),
  FOREIGN KEY (user_id) REFERENCES users(id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

ALTER TABLE restaurant_tables
  ADD CONSTRAINT fk_table_current_reservation
  FOREIGN KEY (current_reservation_id) REFERENCES reservations(id) ON DELETE SET NULL;

-- 11. RESERVATION_TABLES (ghép bàn)
CREATE TABLE reservation_tables (
  reservation_id INT UNSIGNED NOT NULL,
  table_id INT UNSIGNED NOT NULL,
  PRIMARY KEY (reservation_id, table_id),
  FOREIGN KEY (reservation_id) REFERENCES reservations(id) ON DELETE CASCADE,
  FOREIGN KEY (table_id) REFERENCES restaurant_tables(id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- 12. DEPOSITS
CREATE TABLE deposits (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  reservation_id INT UNSIGNED NOT NULL UNIQUE,
  amount DECIMAL(10,2) NOT NULL DEFAULT 50000,
  status ENUM('cho_thanh_toan','da_coc','dang_hoan','da_hoan','hoan_that_bai','mat_coc','da_tru_bill','da_huy') NOT NULL DEFAULT 'cho_thanh_toan',
  transaction_code VARCHAR(100) NULL,
  refund_bank_code VARCHAR(20) NULL,
  refund_account_number VARCHAR(50) NULL,
  refund_account_name VARCHAR(100) NULL,
  refund_transaction_code VARCHAR(100) NULL,
  paid_at DATETIME NULL,
  confirmed_by INT UNSIGNED NULL,
  refunded_at DATETIME NULL,
  refunded_by INT UNSIGNED NULL,
  forfeited_at DATETIME NULL,
  refund_failed_reason VARCHAR(255) NULL,
  FOREIGN KEY (reservation_id) REFERENCES reservations(id) ON DELETE CASCADE,
  FOREIGN KEY (confirmed_by) REFERENCES users(id),
  CONSTRAINT fk_deposits_refunded_by FOREIGN KEY (refunded_by) REFERENCES users(id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- 13. BILLS
CREATE TABLE bills (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  table_id INT UNSIGNED NOT NULL,
  reservation_id INT UNSIGNED NULL,
  status ENUM('mo','da_thanh_toan') NOT NULL DEFAULT 'mo',
  total_amount DECIMAL(10,2) NOT NULL DEFAULT 0,
  deposit_id INT UNSIGNED NULL,
  payment_method ENUM('online','tien_mat') NULL,
  payment_code VARCHAR(100) NULL,
  paid_by INT UNSIGNED NULL,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  paid_at DATETIME NULL,
  INDEX idx_bills_status (status),
  FOREIGN KEY (table_id) REFERENCES restaurant_tables(id),
  FOREIGN KEY (reservation_id) REFERENCES reservations(id),
  FOREIGN KEY (deposit_id) REFERENCES deposits(id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- 14. TABLE_TRANSFERS (lịch sử chuyển bàn)
CREATE TABLE table_transfers (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  reservation_id INT UNSIGNED NULL,
  bill_id INT UNSIGNED NULL,
  from_table_id INT UNSIGNED NOT NULL,
  to_table_id INT UNSIGNED NOT NULL,
  moved_by INT UNSIGNED NULL,
  moved_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  INDEX idx_table_transfers_reservation (reservation_id),
  INDEX idx_table_transfers_moved_at (moved_at),
  FOREIGN KEY (reservation_id) REFERENCES reservations(id) ON DELETE SET NULL,
  FOREIGN KEY (bill_id) REFERENCES bills(id) ON DELETE SET NULL,
  FOREIGN KEY (from_table_id) REFERENCES restaurant_tables(id),
  FOREIGN KEY (to_table_id) REFERENCES restaurant_tables(id),
  FOREIGN KEY (moved_by) REFERENCES users(id) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- 15. BILL_ITEMS
CREATE TABLE bill_items (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  bill_id INT UNSIGNED NOT NULL,
  dish_id INT UNSIGNED NOT NULL,
  quantity INT NOT NULL,
  unit_price DECIMAL(10,2) NOT NULL,
  status ENUM('cho_xac_nhan','dang_che_bien','san_sang','da_phuc_vu') NOT NULL DEFAULT 'cho_xac_nhan',
  note VARCHAR(255) NULL,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  deleted_at DATETIME NULL,
  FOREIGN KEY (bill_id) REFERENCES bills(id) ON DELETE CASCADE,
  FOREIGN KEY (dish_id) REFERENCES dishes(id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- 16. BILL_REVIEWS
CREATE TABLE bill_reviews (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  bill_id INT UNSIGNED NOT NULL UNIQUE,
  user_id INT UNSIGNED NOT NULL,
  rating TINYINT UNSIGNED NOT NULL,
  food_rating TINYINT UNSIGNED NULL,
  service_rating TINYINT UNSIGNED NULL,
  ambience_rating TINYINT UNSIGNED NULL,
  comment TEXT NOT NULL,
  manager_reply TEXT NULL,
  replied_by INT UNSIGNED NULL,
  replied_at DATETIME NULL,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  CONSTRAINT chk_bill_reviews_rating CHECK (rating BETWEEN 1 AND 5),
  CONSTRAINT chk_bill_reviews_category_ratings CHECK (
    (food_rating IS NULL OR food_rating BETWEEN 1 AND 5)
    AND (service_rating IS NULL OR service_rating BETWEEN 1 AND 5)
    AND (ambience_rating IS NULL OR ambience_rating BETWEEN 1 AND 5)
  ),
  FOREIGN KEY (bill_id) REFERENCES bills(id) ON DELETE CASCADE,
  FOREIGN KEY (user_id) REFERENCES users(id),
  CONSTRAINT fk_bill_reviews_replied_by FOREIGN KEY (replied_by) REFERENCES users(id) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- 17. BILL_REVIEW_ITEMS
CREATE TABLE bill_review_items (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  bill_review_id INT UNSIGNED NOT NULL,
  bill_item_id INT UNSIGNED NOT NULL,
  sentiment ENUM('like','dislike') NOT NULL,
  UNIQUE KEY uq_bill_review_item (bill_review_id, bill_item_id),
  FOREIGN KEY (bill_review_id) REFERENCES bill_reviews(id) ON DELETE CASCADE,
  FOREIGN KEY (bill_item_id) REFERENCES bill_items(id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- 18. RESERVATION_PREORDERS
CREATE TABLE reservation_preorders (
  reservation_id INT UNSIGNED PRIMARY KEY,
  contact_status ENUM('cho_lien_he','da_xac_nhan','khong_nghe_may','tu_choi') NOT NULL DEFAULT 'cho_lien_he',
  contacted_at DATETIME NULL,
  contacted_by INT UNSIGNED NULL,
  preparation_status ENUM('cho_xac_nhan','da_dua_vao_bill') NOT NULL DEFAULT 'cho_xac_nhan',
  prepared_at DATETIME NULL,
  prepared_by INT UNSIGNED NULL,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (reservation_id) REFERENCES reservations(id) ON DELETE CASCADE,
  FOREIGN KEY (contacted_by) REFERENCES users(id) ON DELETE SET NULL,
  FOREIGN KEY (prepared_by) REFERENCES users(id) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- 19. RESERVATION_PREORDER_ITEMS
CREATE TABLE reservation_preorder_items (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  reservation_id INT UNSIGNED NOT NULL,
  dish_id INT UNSIGNED NOT NULL,
  quantity INT NOT NULL,
  unit_price DECIMAL(10,2) NOT NULL,
  note VARCHAR(255) NULL,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  INDEX idx_reservation_preorder_items_reservation (reservation_id),
  FOREIGN KEY (reservation_id) REFERENCES reservations(id) ON DELETE CASCADE,
  FOREIGN KEY (dish_id) REFERENCES dishes(id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- 20. REVIEWS (bảng đánh giá cũ, vẫn giữ)
CREATE TABLE reviews (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  user_id INT UNSIGNED NOT NULL,
  bill_id INT UNSIGNED NOT NULL UNIQUE,
  rating TINYINT NOT NULL,
  comment TEXT NULL,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at DATETIME NULL,
  FOREIGN KEY (user_id) REFERENCES users(id),
  FOREIGN KEY (bill_id) REFERENCES bills(id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- 21. CONVERSATIONS
CREATE TABLE conversations (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  customer_id INT UNSIGNED NOT NULL,
  staff_id INT UNSIGNED NULL,
  status ENUM('open','closed') NOT NULL DEFAULT 'open',
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  closed_at DATETIME NULL,
  closed_by INT UNSIGNED NULL,
  INDEX idx_conversations_customer_status (customer_id, status),
  INDEX idx_conversations_staff_status (staff_id, status),
  FOREIGN KEY (customer_id) REFERENCES users(id),
  FOREIGN KEY (staff_id) REFERENCES users(id),
  CONSTRAINT fk_conversations_closed_by FOREIGN KEY (closed_by) REFERENCES users(id) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- 22. MESSAGES
CREATE TABLE messages (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  conversation_id INT UNSIGNED NOT NULL,
  sender_id INT UNSIGNED NOT NULL,
  content TEXT NOT NULL,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  is_read BOOLEAN NOT NULL DEFAULT FALSE,
  attachment_filename VARCHAR(255) NULL,
  attachment_mime VARCHAR(100) NULL,
  attachment_size BIGINT UNSIGNED NULL,
  attachment_path VARCHAR(500) NULL,
  INDEX idx_messages_conversation_created (conversation_id, created_at, id),
  FOREIGN KEY (conversation_id) REFERENCES conversations(id) ON DELETE CASCADE,
  FOREIGN KEY (sender_id) REFERENCES users(id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- 23. DISH_RECOMMENDATIONS
CREATE TABLE dish_recommendations (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  user_id INT UNSIGNED NULL,
  dish_id INT UNSIGNED NOT NULL,
  model_name VARCHAR(50) NOT NULL DEFAULT 'popularity',
  score DECIMAL(10,4) NOT NULL DEFAULT 0,
  rank_order INT NOT NULL,
  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  UNIQUE KEY uq_user_dish_model (user_id, dish_id, model_name),
  FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
  FOREIGN KEY (dish_id) REFERENCES dishes(id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- 24. RECOMMENDATION_EVALUATIONS
CREATE TABLE recommendation_evaluations (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  model_name VARCHAR(50) NOT NULL,
  k_value INT NOT NULL,
  precision_at_k DECIMAL(6,4) NOT NULL,
  recall_at_k DECIMAL(6,4) NOT NULL,
  ndcg_at_k DECIMAL(6,4) NOT NULL,
  evaluated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- 25. USER_PREFERRED_INGREDIENTS
CREATE TABLE user_preferred_ingredients (
  user_id INT UNSIGNED NOT NULL,
  ingredient_id INT UNSIGNED NOT NULL,
  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (user_id, ingredient_id),
  INDEX idx_user_preferred_ingredient (ingredient_id),
  FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
  FOREIGN KEY (ingredient_id) REFERENCES ingredients(id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
